# apps/api — copy to .env and fill in real values
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tglobal_gold_loan?schema=public"
PORT=4000

# Gold rate stored as integer paise (1 paise = ₹0.01)
# 700000 paise = ₹7,000.00 per gram for 24k gold
GOLD_RATE_24K_PAISE=700000

# LLM provider: gemini | groq | ollama | mock
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
RATE_LIMIT_WINDOW_MS=60000
LEADS_RATE_LIMIT_MAX=10
AGENT_CHAT_RATE_LIMIT_MAX=30
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
